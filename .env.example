# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# ── Backend ────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend (no trailing slash).
VITE_API_URL=http://localhost:8000

# UUID of the admin account that owns this storefront's users and products.
# Create the admin once via POST /users (admin_id: null), then paste its id here.
VITE_ADMIN_ID=

# ── Google OAuth ───────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins must include http://localhost:3000 (dev)
# and your production domain.
VITE_GOOGLE_CLIENT_ID=
